# ---------------------------------------------------------------------------
# Lumia / Lio — environment configuration
#
# Copy to .env and fill in what you need:      cp .env.example .env
# .env is gitignored — never commit real keys.
#
# NOTHING HERE IS REQUIRED TO BOOT. The app starts with an empty .env and
# every value below falls back to the default shown. Features whose keys are
# missing fail at the moment you use them, not at startup — so you can run the
# UI locally with no credentials at all.
#
# In production these are set in Railway → Variables, not from a file.
# ---------------------------------------------------------------------------


# --- Core app -------------------------------------------------------------
# FLASK_SECRET signs session cookies. The default below is a known public
# string — anyone who reads this repo can forge a session with it. Set a real
# random value in production:  python -c "import secrets;print(secrets.token_hex(32))"
FLASK_SECRET=lumia-ashrah-secret-2026
LUMIA_PORT=5000
LIO_PORT=5050
APP_BASE_URL=https://lumia.ashrah.ai
PUBLIC_BASE_URL=https://lumia.ashrah.ai

# Owner/staff login. OWNER_PIN empty means the owner PIN login is disabled.
OWNER_PIN=
OWNER_EMAIL=ahmdashrah@gmail.com
LUMIA_OWNER_EMAIL=ahmad@ashrahpainting.ca
LUMIA_WORKER_EMAILS=
LUMIA_API_KEY=


# --- Database (Supabase) --------------------------------------------------
# Without these the app runs but check-ins, jobs and employees have nowhere
# to persist. SERVICE_KEY bypasses row-level security — server-side only.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=


# --- LLM providers --------------------------------------------------------
# Anthropic drives Lumia chat, Lio's agents, crew learning and estimates.
ANTHROPIC_API_KEY=
# Gemini drives image generation and voice transcription.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# OpenAI drives contract extraction.
OPENAI_API_KEY=

# Model pinning. Override without touching code.
# NOTE: claude-opus-4-7 is pinned in five places (including the hardcoded
# GENERATION_MODEL in lio/core/engine.py). Confirm that ID is current before
# relying on it — a stale ID fails at call time, not at startup.
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_MODEL_CLIENT=claude-opus-4-7
CREW_LEARN_MODEL=claude-haiku-4-5
ESTIMATE_CHAT_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-2.5-flash
VOICE_TRANSCRIBE_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o


# --- Agent budgets --------------------------------------------------------
# MI = market_intel capability, SCOUT = the lead scout. Budgets are token
# ceilings per task; searches cap web-search calls per run.
MI_MODEL=claude-opus-4-7
MI_MAX_SEARCHES=5
MI_MAX_OUTPUT_TOKENS=4000
MI_TASK_BUDGET=50000
SCOUT_MODEL=claude-opus-4-7
SCOUT_MAX_SEARCHES=4
SCOUT_MAX_OUTPUT_TOKENS=4000
SCOUT_TASK_BUDGET=50000
SEMANTIC_SCHOLAR_API_KEY=


# --- Ops email (Zoho) — daily reports, escalations -----------------------
ZOHO_EMAIL=ops@ashrahpainting.com
ZOHO_PASSWORD=
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_IMAP_HOST=imap.zoho.com
ZOHO_IMAP_PORT=993
ZOHO_IMAP_USER=
ZOHO_IMAP_PASSWORD=
RESEND_API_KEY=


# --- Lio outbound mailbox -------------------------------------------------
# Separate mailbox from ops so cold outreach can't touch operational mail.
LIO_SMTP_USER=lio.ashrah@ashrahpainting.ca
LIO_SMTP_PASSWORD=
LIO_SMTP_HOST=smtp.zoho.com
LIO_SMTP_PORT=465
LIO_SMTP_USE_SSL=true
LIO_IMAP_USER=
LIO_IMAP_PASSWORD=
LIO_IMAP_HOST=imap.zoho.com
LIO_IMAP_PORT=993
LIO_IMAP_FOLDER=INBOX
LIO_FROM_NAME=Lio Ashrah
LIO_FROM_EMAIL=
LIO_REPLY_TO=
LIO_TITLE=Marketing Coordinator
LIO_COMPANY_DISPLAY=Ashrah Painting
LIO_WEBSITE=ashrahpainting.ca
LIO_SIGNATURE=


# --- Construction platforms (see docs/integrations.md) -------------------
# Procore: from https://developers.procore.com. Use a Data Management
# Service Account for unattended pushes. Unset = integration simply idle.
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_COMPANY_ID=
# Point at Procore's sandbox while verifying the daily-log mapping.
PROCORE_SANDBOX=false


# --- SMS (Twilio) ---------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# --- Company identity (quotes, contracts, PDFs) --------------------------
COMPANY_LEGAL_NAME=Ashrah Painting Ltd.
COMPANY_CITY=Winnipeg, MB
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=ahmad@ashrahpainting.ca
COMPANY_GST=
COMPANY_SIGNATORY=Ahmad Ashrah
COMPANY_SIGNATORY_TITLE=President
KICKOFF_SPECIALIST_NAME=Abdelhadi


# --- Estimating defaults (dollars) ---------------------------------------
ESTIMATE_RATE_CEILINGS=4.0
ESTIMATE_RATE_NO_CEILINGS=3.5
ESTIMATE_DOOR_PRICE=50.0
ESTIMATE_EPOXY_PRICE=4.0


# --- Misc -----------------------------------------------------------------
CLIENT_CHAT_ALLOWED_EMAILS=
DEMO_CLIENT_EMAIL=client@example.com
